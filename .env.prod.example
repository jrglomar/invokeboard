# ── InvokeBoard — PRODUCTION environment (docker-compose.prod.yml, v1.74 / ADR-085) ──────────
# On the server:   cp .env.prod.example .env   then fill in real values.
# NEVER copy this .env into the same place/archive as a data export or a MySQL dump:
# TOKEN_ENC_KEY decrypts every sealed Jira/GitHub/AI token stored in the database.

# ── Jira — required by BOTH bridges ──────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_atlassian_api_token

# ── Jira boards / projects — required by mcp-jira ────────────────────────────
JIRA_DEV_BOARD_ID=1234
JIRA_DEV_PROJECT_KEY=DEV
JIRA_PO_BOARD_ID=5678
JIRA_PO_PROJECT_KEY=PO

# ── Jira field mapping — optional ────────────────────────────────────────────
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_LINK_TYPE=Depends on
JIRA_FLAGGED_FIELD=
JIRA_CODE_REVIEW_STATUSES=code review,in review,peer review,review
JIRA_VELOCITY_SPRINTS=6

# ── GitHub — required by mcp-github ──────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=owner/repo

# ── Accounts (Task Helper / per-user connections / teams) ────────────────────
# MIGRATING existing data? Copy TOKEN_ENC_KEY and SESSION_SECRET VERBATIM from the current
# deployment's .env — a new TOKEN_ENC_KEY makes every stored connection token undecryptable,
# a new SESSION_SECRET just logs everyone out.
# Fresh install? Generate:
#   openssl rand -base64 32     # TOKEN_ENC_KEY  (must decode to exactly 32 bytes)
#   openssl rand -base64 48     # SESSION_SECRET
TOKEN_ENC_KEY=
SESSION_SECRET=
ADMIN_EMAILS=you@example.com

# ── MySQL (the `mysql` service + the jira bridge's STORAGE_MYSQL_URL) ────────
# Use URL-SAFE passwords (letters + digits only) — the password is embedded in a mysql:// URL.
#   openssl rand -hex 24
MYSQL_DATABASE=invokeboard
MYSQL_USER=invokeboard
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Cloudflare Tunnel — public access without opening any port ───────────────
# Zero Trust → Networks → Tunnels → your tunnel → token. Point its public hostname at http://web:80.
# Not using a tunnel? Delete the cloudflared service from docker-compose.prod.yml instead.
CF_TUNNEL_TOKEN=

# ── AI drafting — optional. Unset = disabled (deterministic templates). ──────
# AI_PROVIDER=github
# GITHUB_MODELS_TOKEN=ghp_...
# ANTHROPIC_API_KEY=sk-ant-...

# ── CORS — not needed behind the bundled nginx proxy (same origin). ──────────
# CORS_ORIGINS=https://your-dashboard.example.com
